# Dependencies
node_modules/

# Build output (regenerated every build; the icons below are committed)
build/*
!build/icon.png
!build/icon.ico

# Packaged apps
release/
dist/
real-dist/

# CI workflows are kept local until the GitHub token gains `workflow` scope
# (SignPath Foundation signing template in .github/workflows/build.yml)
/.github/workflows/

# Local secrets — never commit
.env
.env.local
*.secret

# Logs / OS noise
npm-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db
desktop.ini